#!/bin/bash

set -xo pipefail
set -eE

WORKFLOW="proteindj"
RUN_DIR=$(echo "<%= context.run_name %>" | sed "s#[^A-Za-z0-9]#_#g")

ENV_FILE=".env"
if [ -f "$ENV_FILE" ]; then
    set -a
    . "$ENV_FILE"
    set +a
fi

DEBUGGROUP=${DEBUGGROUP:-sbf}
BASE_DEBUGDIR=${BASE_DEBUGDIR:-/srv/scratch/sbf/debug}
METRICS_DIRECTORY=${METRICS_DIRECTORY:-/srv/scratch/sbf-pipelines/metrics}
ENABLE_METRICS=${ENABLE_METRICS:-true}
NOW=$(date +%Y%m%d_%H%M%S)
RUNNAME="${NOW}_${USER}"
DEBUGDIR="${BASE_DEBUGDIR}/proteindesign_${WORKFLOW}_${RUNNAME}"

collect_debug_files() {
    local exit_code=$?

    trap - ERR
    set +e
    echo "Error occurred, copying debug files to ${DEBUGDIR}"
    mkdir -p "${DEBUGDIR}"
    {
        echo "captured_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "user=${USER}"
        echo "node=$(hostname)"
        echo "pbs_jobid=${PBS_JOBID:-}"
        echo "workflow=${WORKFLOW}"
        echo "run_name=<%= context.run_name %>"
        echo "session_output_dir=$(pwd -P)"
        echo "nxf_work=${NXF_WORK:-}"
        echo "exit_code=${exit_code}"
    } > "${DEBUGDIR}/debug-metadata.txt"
    rsync -a --no-perms --no-owner --no-group --max-size=50m . "${DEBUGDIR}/"
    if [ -n "${NXF_WORK:-}" ] && [ -d "${NXF_WORK}" ]; then
        rsync -a --no-perms --no-owner --no-group --max-size=50m "${NXF_WORK}" "${DEBUGDIR}/"
    fi
    chgrp "${DEBUGGROUP}" -R "${DEBUGDIR}"
    find "${DEBUGDIR}" -type d -exec chmod 2770 {} +
    find "${DEBUGDIR}" -type f -exec chmod 660 {} +
    exit "${exit_code}"
}

write_metrics() {
    local repository="$1"
    local revision="$2"
    local nf_config="$3"
    local workflow_args="$4"
    local metrics_log_path

    [[ "${ENABLE_METRICS}" == "true" ]] || return 0
    metrics_log_path="${METRICS_DIRECTORY}/$(date +%Y/%m)"
    if ! mkdir -p "${metrics_log_path}" || ! jq -n \
        --arg date "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg user "$(whoami)" \
        --arg node "$(hostname)" \
        --arg pbs_jobid "${PBS_JOBID:-}" \
        --arg app "ood-proteindesign" \
        --arg workflow "${WORKFLOW}" \
        --arg run_name "<%= context.run_name %>" \
        --arg repository "${repository}" \
        --arg revision "${revision}" \
        --arg nf_config "${nf_config}" \
        --arg target "${target}" \
        --arg hotspots "${hotspots}" \
        --arg min_length "${min_length}" \
        --arg max_length "${max_length}" \
        --arg number_of_designs "${ndesigns}" \
        --arg outdir "${OUT_DIR}" \
        --arg nxf_work "${NXF_WORK}" \
        --arg profile "apptainer" \
        --arg args "${workflow_args}" \
        '{date: $date, user: $user, node: $node, pbs_jobid: $pbs_jobid, app: $app, workflow: $workflow, run_name: $run_name, repository: $repository, revision: $revision, nf_config: $nf_config, target: $target, hotspots: $hotspots, min_length: $min_length, max_length: $max_length, number_of_designs: $number_of_designs, outdir: $outdir, nxf_work: $nxf_work, profile: $profile, args: $args}' \
        > "${metrics_log_path}/$(date -u +%Y-%m-%dT%H:%M:%SZ)-$(whoami)-${PBS_JOBID:-unknown}.json"; then
        echo "Warning: unable to write metrics log to ${metrics_log_path}; continuing without metrics." >&2
    fi
}

trap 'collect_debug_files' ERR

require_var() {
    local name="$1"
    if [ -z "${!name:-}" ]; then
        echo "ERROR: Required config variable '$name' is not set. Define it in template/.env or the environment." >&2
        exit 1
    fi
}

require_var APPTAINER_CACHEDIR
require_var NXF_APPTAINER_CACHEDIR
require_var NXF_APPTAINER_LIBRARYDIR

module purge
module load java/21 nextflow/25

# ProteinDJ 3 requires the legacy parser when sites upgrade to Nextflow 26+.
export NXF_SYNTAX_PARSER="${NXF_SYNTAX_PARSER:-v1}"

export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR}"
export NXF_APPTAINER_CACHEDIR="${NXF_APPTAINER_CACHEDIR}"
export NXF_APPTAINER_LIBRARYDIR="${NXF_APPTAINER_LIBRARYDIR}"

    require_var PROTEINDESIGN_PDJ_BASEDIR
    require_var PROTEINDESIGN_PDJ_REPOSITORY
    require_var PROTEINDESIGN_PDJ_REVISION
    require_var PROTEINDESIGN_PDJ_NEXTFLOW_CONFIG
    require_var PROTEINDESIGN_PDJ_WORK_DIR
    require_var PROTEINDESIGN_PDJ_OUT_DIR
    BASE_DIR="${PROTEINDESIGN_PDJ_BASEDIR}"
    MODEL_DIR=${BASE_DIR}/models/
    PDJ_REPOSITORY="${PROTEINDESIGN_PDJ_REPOSITORY}"
    PDJ_REVISION="${PROTEINDESIGN_PDJ_REVISION}"
    PDJ_NEXTFLOW_CONFIG="${PROTEINDESIGN_PDJ_NEXTFLOW_CONFIG}"
    # Keep the container set aligned with the pinned ProteinDJ3 deployment.
    # These are application compatibility settings, not per-site overrides.
    PDJ_CONTAINER_REGISTRY="oras://ghcr.io/papenfusslab/proteindj"
    PDJ_CONTAINER_VERSION="v3.0"

    # Local Nextflow scripts cannot be selected with -r. Validate the pin
    # directly when the deployment points at a Git checkout instead.
    PDJ_VERSION_ARGS=()
    if [ -d "${PDJ_REPOSITORY}" ]; then
        if [ -d "${PDJ_REPOSITORY}/.git" ] && command -v git >/dev/null 2>&1; then
            actual_revision=$(git -C "${PDJ_REPOSITORY}" rev-parse HEAD)
            if ! expected_revision=$(git -C "${PDJ_REPOSITORY}" rev-parse --verify "${PDJ_REVISION}^{commit}" 2>/dev/null); then
                echo "ERROR: ProteinDJ revision ${PDJ_REVISION} does not exist in ${PDJ_REPOSITORY}." >&2
                exit 1
            fi
            if [ "${actual_revision}" != "${expected_revision}" ]; then
                echo "ERROR: ProteinDJ checkout ${PDJ_REPOSITORY} is at ${actual_revision}, expected ${PDJ_REVISION} (${expected_revision})." >&2
                exit 1
            fi
        fi
    else
        PDJ_VERSION_ARGS=(-r "${PDJ_REVISION}" -latest)
    fi

    export NXF_WORK="${PROTEINDESIGN_PDJ_WORK_DIR}"
    mkdir -p "${NXF_WORK}"

    BASE_OUT_DIR="${BASE_OUT_DIR:-${PROTEINDESIGN_PDJ_OUT_DIR}}"
    OUT_DIR="${BASE_OUT_DIR}/${RUN_DIR}"
    mkdir -p "${OUT_DIR}"
    LIVE_LOG="live_log.log"
    if [ -z "${OOD_LIVE_LOG_INIT:-}" ]; then
        export OOD_LIVE_LOG_INIT=1
        : > "${LIVE_LOG}"
        exec > >(tee -a "${LIVE_LOG}")
        exec 2>&1
    fi

    run_name="<%= context.run_name %>"
    target="<%= context.target %>"
    # Keep the interactive design target compact enough for the configured
    # workflow/resources. Count unique standard amino-acid residues across all
    # chains and warn about oversized, but still allowed, PDB inputs.
    min_target_residues=50
    max_target_residues=300
    declare -A target_chains=()
    declare -A target_residues=()
    declare -A target_residue_keys=()

    load_target_residues() {
        target_chains=()
        target_residues=()
        target_residue_keys=()
        while IFS='|' read -r residue_chain residue_number residue_field insertion; do
            [ -z "${residue_chain}" ] && continue
            target_residue_keys["${residue_chain}:${residue_field}:${insertion}"]=1
            target_chains["${residue_chain}"]=1
            target_residues["${residue_chain}:${residue_number}"]=1
        done < <(awk '
            BEGIN {
                split("ALA ARG ASN ASP CYS GLN GLU GLY HIS ILE LEU LYS MET PHE PRO SER THR TRP TYR VAL", aa)
                for (i in aa) allowed[aa[i]] = 1
            }
            /^ATOM  / {
                residue = substr($0, 18, 3)
                if (!allowed[residue]) next
                chain_id = substr($0, 22, 1)
                residue_field = substr($0, 23, 4)
                insertion = substr($0, 27, 1)
                key = chain_id ":" residue_field ":" insertion
                if (!seen[key]++) print chain_id "|" (residue_field + 0) "|" residue_field "|" insertion
            }
        ' "${target}")
        target_residue_count=${#target_residue_keys[@]}
    }

    load_target_residues
    if [ "${target_residue_count}" -eq 0 ]; then
        echo "Target PDB contains no parseable standard amino-acid residues: ${target}" >&2
        exit 1
    fi
    if [ "${target_residue_count}" -lt "${min_target_residues}" ]; then
        echo "Structure has only ${target_residue_count} residue(s). Minimum ${min_target_residues} residues required." >&2
        exit 1
    fi
    if [ "${target_residue_count}" -gt "${max_target_residues}" ]; then
        echo "Warning: target structure has ${target_residue_count} amino-acid residues; targets above ${max_target_residues} may be less efficient but are allowed." >&2
    else
        echo "Validated target structure: ${target_residue_count} amino-acid residues (suggested maximum ${max_target_residues})."
    fi

    # An optional Mol* crop is represented as chain-qualified residue ranges.
    # Keep the submitted target read-only and write the derived PDB beside the
    # job script; ProteinDJ receives the derived path below.
    target_crop_raw="<%= context.target_crop %>"
    target_crop=$(echo "${target_crop_raw}" | tr -d '[:space:]')
    if [ -n "${target_crop}" ]; then
        declare -A crop_residues=()
        IFS=',' read -r -a crop_items <<< "${target_crop}"
        for item in "${crop_items[@]}"; do
            if [[ ! "${item}" =~ ^([A-Za-z]+)([0-9]+)(-([0-9]+))?$ ]]; then
                echo "Invalid crop range: ${item}. Use a chain-qualified range such as A120-310." >&2
                exit 1
            fi
            crop_chain="${BASH_REMATCH[1]}"
            crop_start=$((10#${BASH_REMATCH[2]}))
            crop_end="${BASH_REMATCH[4]:-${crop_start}}"
            crop_end=$((10#${crop_end}))
            if [ "${crop_end}" -lt "${crop_start}" ]; then
                echo "Crop range has a descending end: ${item}" >&2
                exit 1
            fi
            if [ -z "${target_chains[${crop_chain}]+x}" ]; then
                echo "Crop chain ${crop_chain} is not present in target structure: ${item}" >&2
                exit 1
            fi
            if [ -z "${target_residues[${crop_chain}:${crop_start}]+x}" ] ||
               [ -z "${target_residues[${crop_chain}:${crop_end}]+x}" ]; then
                echo "Crop range is not present in target structure: ${item}" >&2
                exit 1
            fi
            for ((crop_residue = crop_start; crop_residue <= crop_end; crop_residue++)); do
                if [ -n "${target_residues[${crop_chain}:${crop_residue}]+x}" ]; then
                    crop_residues["${crop_chain}:${crop_residue}"]=1
                fi
            done
        done

        cropped_target="${PWD}/target.cropped.pdb"
        printf '%s\n' "${!crop_residues[@]}" | awk '
            NR == FNR { wanted[$0] = 1; next }
            /^ATOM  / {
                chain_id = substr($0, 22, 1)
                residue_id = substr($0, 23, 4) + 0
                if (wanted[chain_id ":" residue_id]) print
            }
            END { print "END" }
        ' - "${target}" > "${cropped_target}"
        target="${cropped_target}"

        load_target_residues
        if [ "${target_residue_count}" -lt "${min_target_residues}" ]; then
            echo "Crop contains only ${target_residue_count} residue(s). Minimum ${min_target_residues} residues required." >&2
            exit 1
        fi
        echo "Created derived cropped target: ${target_residue_count} amino-acid residues at ${target}."
    fi

    design_mode="<%= context.pdj_design_mode %>"
    seq_method="<%= context.pdj_seq_method %>"
    pred_method="<%= context.pdj_pred_method %>"
    hotspots_raw="<%= context.hotspots %>"
    hotspots_clean=$(echo "${hotspots_raw}" | tr -d '[:space:]' | sed -E 's/,+/,/g; s/^,//; s/,$//')

    # Mol* supplies chain-qualified hotspots directly; preserve PDB chain-ID
    # case because chain IDs are case-sensitive. Numeric legacy input is still
    # accepted when the target contains exactly one chain.
    hotspots="${hotspots_clean}"
    if [ -n "${hotspots}" ]; then
        IFS=',' read -r -a hotspot_items <<< "${hotspots}"
        normalized_hotspots=""
        for item in "${hotspot_items[@]}"; do
            if [[ "${item}" =~ ^([A-Za-z]+)$ ]]; then
                hotspot_chain="${BASH_REMATCH[1]}"
                if [ -z "${target_chains[${hotspot_chain}]+x}" ]; then
                    echo "Hotspot chain ${hotspot_chain} is not present in target structure: ${item}" >&2
                    exit 1
                fi
                normalized_item="${hotspot_chain}"
            else
                if [[ "${item}" =~ ^([0-9]+)(-([0-9]+))?$ ]]; then
                    if [ "${#target_chains[@]}" -ne 1 ]; then
                        echo "Numeric hotspot ${item} is ambiguous for a multi-chain target; include its chain." >&2
                        exit 1
                    fi
                    for hotspot_chain in "${!target_chains[@]}"; do break; done
                    hotspot_start=$((10#${BASH_REMATCH[1]}))
                    hotspot_end=$((10#${BASH_REMATCH[3]:-${hotspot_start}}))
                elif [[ "${item}" =~ ^([A-Za-z]+)([0-9]+)(-([0-9]+))?$ ]]; then
                    hotspot_chain="${BASH_REMATCH[1]}"
                    hotspot_start=$((10#${BASH_REMATCH[2]}))
                    hotspot_end=$((10#${BASH_REMATCH[4]:-${hotspot_start}}))
                else
                    echo "Invalid chain-qualified hotspot: ${item}" >&2
                    exit 1
                fi

                if [ -z "${target_chains[${hotspot_chain}]+x}" ]; then
                    echo "Hotspot chain ${hotspot_chain} is not present in target structure: ${item}" >&2
                    exit 1
                fi
                if [ "${hotspot_end}" -lt "${hotspot_start}" ]; then
                    echo "Hotspot range has a descending end: ${item}" >&2
                    exit 1
                fi
                if [ -z "${target_residues[${hotspot_chain}:${hotspot_start}]+x}" ]; then
                    echo "Hotspot residue ${hotspot_start} not found in chain ${hotspot_chain}: ${item}" >&2
                    exit 1
                fi
                if [ "${hotspot_start}" -ne "${hotspot_end}" ] && [ -z "${target_residues[${hotspot_chain}:${hotspot_end}]+x}" ]; then
                    echo "End residue ${hotspot_end} not found in chain ${hotspot_chain}: ${item}" >&2
                    exit 1
                fi
                normalized_item="${hotspot_chain}${hotspot_start}"
                if [ "${hotspot_end}" -ne "${hotspot_start}" ]; then
                    normalized_item+="-${hotspot_end}"
                fi
            fi

            normalized_hotspots+="${normalized_hotspots:+,}${normalized_item}"
        done
        hotspots="${normalized_hotspots}"
    fi
    min_length="<%= context.minlen %>"
    max_length="<%= context.maxlen %>"
    ndesigns="<%= context.ndesigns %>"
    nseqs="<%= context.seqs_per_design %>"
    design_length="${min_length}-${max_length}"

    af2_max_pae_interaction="<%= context.af2_max_pae_interaction %>"
    af2_min_iptm="<%= context.af2_min_iptm %>"
    af2_min_plddt_overall="<%= context.af2_min_plddt_overall %>"
    af2_max_rmsd_binder_bndaln="<%= context.af2_max_rmsd_binder_bndaln %>"
    af2_max_rmsd_binder_tgtaln="<%= context.af2_max_rmsd_binder_tgtaln %>"

    boltz_max_rmsd_binder="<%= context.boltz_max_rmsd_binder %>"
    boltz_max_rmsd_target="<%= context.boltz_max_rmsd_target %>"
    boltz_max_rmsd_overall="<%= context.boltz_max_rmsd_overall %>"
    boltz_min_iptm="<%= context.boltz_min_iptm %>"
    boltz_min_ipsae_min="<%= context.boltz_min_ipsae_min %>"
    boltz_min_pdockq2_min="<%= context.boltz_min_pdockq2_min %>"
    pr_min_intface_shpcomp="<%= context.pr_min_intface_shpcomp %>"
    pr_min_intface_hbonds="<%= context.pr_min_intface_hbonds %>"
    pr_max_intface_unsat_hbonds="<%= context.pr_max_intface_unsat_hbonds %>"
    pr_max_surfhphobics="<%= context.pr_max_surfhphobics %>"

    mpnn_relax_max_cycles="<%= context.mpnn_relax_max_cycles %>"
    mpnn_checkpoint_type="<%= context.mpnn_checkpoint_type %>"
    mpnn_checkpoint_model="<%= context.mpnn_checkpoint_model %>"
    mpnn_backbone_noise="<%= context.mpnn_backbone_noise %>"
    uncropped_target_pdb="<%= context.uncropped_target_pdb %>"
    boltz_use_templates="<%= context.boltz_use_templates %>"
    boltz_input_msa="<%= context.boltz_input_msa %>"
    fold_min_ss="<%= context.fold_min_ss %>"
    seq_min_ext_coef="<%= context.seq_min_ext_coef %>"
    max_designs="<%= context.max_designs %>"
    max_seqs_per_fold="<%= context.max_seqs_per_fold %>"
    flexible_residues="<%= context.flexible_residues %>"
    rfd_ckpt_override="<%= context.rfd_ckpt_override %>"
    rfd_noise_scale="<%= context.rfd_noise_scale %>"
    bc_chains="<%= context.bc_chains %>"
    bc_design_protocol="<%= context.bc_design_protocol %>"
    bc_template_protocol="<%= context.bc_template_protocol %>"
    bc_omit_aas="<%= context.bc_omit_aas %>"
    bc_fix_interface_residues="<%= context.bc_fix_interface_residues %>"
    af2_initial_guess="<%= context.af2_initial_guess %>"
    boltz_recycling_steps="<%= context.boltz_recycling_steps %>"
    boltz_diffusion_samples="<%= context.boltz_diffusion_samples %>"
    boltz_sampling_steps="<%= context.boltz_sampling_steps %>"
    boltz_use_potentials="<%= context.boltz_use_potentials %>"
    boltz_predict_unbound_binder="<%= context.boltz_predict_unbound_binder %>"
    zip_pdbs="<%= context.zip_pdbs %>"
    rank_designs="<%= context.rank_designs %>"
    ranking_metric="<%= context.ranking_metric %>"

    pdj_args=(
        --design_mode "${design_mode}"
        --num_designs "${ndesigns}"
        --input_pdb "${target}"
        --design_length "${design_length}"
        --seqs_per_design "${nseqs}"
        --seq_method "${seq_method}"
        --pred_method "${pred_method}"
        --out_dir "${OUT_DIR}"
        --af2_models "${MODEL_DIR}/af2/"
        --mpnn_models "${MODEL_DIR}/mpnn/"
        --rfd_models "${MODEL_DIR}/rfd/"
        --boltz_models "${MODEL_DIR}/boltz/"
    )

    pdj_args+=(--container_registry "${PDJ_CONTAINER_REGISTRY}" --container_version "${PDJ_CONTAINER_VERSION}")

    [ -n "${hotspots}" ] && pdj_args+=(--hotspot_residues "${hotspots}")
    [ -n "${flexible_residues}" ] && pdj_args+=(--flexible_residues "${flexible_residues}")
    [ -n "${rfd_ckpt_override}" ] && pdj_args+=(--rfd_ckpt_override "${rfd_ckpt_override}")
    [ -n "${rfd_noise_scale}" ] && pdj_args+=(--rfd_noise_scale "${rfd_noise_scale}")
    [ -n "${bc_chains}" ] && pdj_args+=(--bc_chains "${bc_chains}")
    [ -n "${bc_design_protocol}" ] && pdj_args+=(--bc_design_protocol "${bc_design_protocol}")
    [ -n "${bc_template_protocol}" ] && pdj_args+=(--bc_template_protocol "${bc_template_protocol}")
    [ -n "${bc_omit_aas}" ] && pdj_args+=(--bc_omit_AAs "${bc_omit_aas}")
    [ -n "${bc_fix_interface_residues}" ] && pdj_args+=(--bc_fix_interface_residues "${bc_fix_interface_residues}")
    [ -n "${zip_pdbs}" ] && pdj_args+=(--zip_pdbs "${zip_pdbs}")
    [ -n "${rank_designs}" ] && pdj_args+=(--rank_designs "${rank_designs}")
    [ -n "${ranking_metric}" ] && pdj_args+=(--ranking_metric "${ranking_metric}")

    if [ "${pred_method}" = "af2" ] || [ "${pred_method}" = "af2_boltz" ]; then
        [ -n "${af2_initial_guess}" ] && pdj_args+=(--af2_initial_guess "${af2_initial_guess}")
        [ -n "${af2_min_iptm}" ] && pdj_args+=(--af2_min_iptm "${af2_min_iptm}")
        [ -n "${af2_max_pae_interaction}" ] && pdj_args+=(--af2_max_pae_interaction "${af2_max_pae_interaction}")
        [ -n "${af2_min_plddt_overall}" ] && pdj_args+=(--af2_min_plddt_overall "${af2_min_plddt_overall}")
        [ -n "${af2_max_rmsd_binder_bndaln}" ] && pdj_args+=(--af2_max_rmsd_binder_bndaln "${af2_max_rmsd_binder_bndaln}")
        [ -n "${af2_max_rmsd_binder_tgtaln}" ] && pdj_args+=(--af2_max_rmsd_binder_tgtaln "${af2_max_rmsd_binder_tgtaln}")
    fi

    if [ "${pred_method}" = "boltz" ] || [ "${pred_method}" = "af2_boltz" ]; then
        [ -n "${boltz_use_templates}" ] && pdj_args+=(--boltz_use_templates "${boltz_use_templates}")
        [ -n "${boltz_input_msa}" ] && pdj_args+=(--boltz_input_msa "${boltz_input_msa}")
        [ -n "${boltz_max_rmsd_binder}" ] && pdj_args+=(--boltz_max_rmsd_binder "${boltz_max_rmsd_binder}")
        [ -n "${boltz_max_rmsd_target}" ] && pdj_args+=(--boltz_max_rmsd_target "${boltz_max_rmsd_target}")
        [ -n "${boltz_max_rmsd_overall}" ] && pdj_args+=(--boltz_max_rmsd_overall "${boltz_max_rmsd_overall}")
        [ -n "${boltz_min_iptm}" ] && pdj_args+=(--boltz_min_iptm "${boltz_min_iptm}")
        [ -n "${boltz_min_ipsae_min}" ] && pdj_args+=(--boltz_min_ipSAE_min "${boltz_min_ipsae_min}")
        [ -n "${boltz_min_pdockq2_min}" ] && pdj_args+=(--boltz_min_pDockQ2_min "${boltz_min_pdockq2_min}")
        [ -n "${boltz_recycling_steps}" ] && pdj_args+=(--boltz_recycling_steps "${boltz_recycling_steps}")
        [ -n "${boltz_diffusion_samples}" ] && pdj_args+=(--boltz_diffusion_samples "${boltz_diffusion_samples}")
        [ -n "${boltz_sampling_steps}" ] && pdj_args+=(--boltz_sampling_steps "${boltz_sampling_steps}")
        [ -n "${boltz_use_potentials}" ] && pdj_args+=(--boltz_use_potentials "${boltz_use_potentials}")
        [ -n "${boltz_predict_unbound_binder}" ] && pdj_args+=(--boltz_predict_unbound_binder "${boltz_predict_unbound_binder}")
    fi

    [ -n "${mpnn_checkpoint_type}" ] && pdj_args+=(--mpnn_checkpoint_type "${mpnn_checkpoint_type}")
    [ -n "${mpnn_checkpoint_model}" ] && pdj_args+=(--mpnn_checkpoint_model "${mpnn_checkpoint_model}")
    [ -n "${mpnn_backbone_noise}" ] && pdj_args+=(--mpnn_backbone_noise "${mpnn_backbone_noise}")
    [ -n "${mpnn_relax_max_cycles}" ] && pdj_args+=(--mpnn_relax_max_cycles "${mpnn_relax_max_cycles}")
    [ -n "${uncropped_target_pdb}" ] && pdj_args+=(--uncropped_target_pdb "${uncropped_target_pdb}")
    [ -n "${fold_min_ss}" ] && pdj_args+=(--fold_min_ss "${fold_min_ss}")
    [ -n "${seq_min_ext_coef}" ] && pdj_args+=(--seq_min_ext_coef "${seq_min_ext_coef}")
    [ -n "${max_designs}" ] && pdj_args+=(--max_designs "${max_designs}")
    [ -n "${max_seqs_per_fold}" ] && pdj_args+=(--max_seqs_per_fold "${max_seqs_per_fold}")
    [ -n "${pr_min_intface_shpcomp}" ] && pdj_args+=(--pr_min_intface_shpcomp "${pr_min_intface_shpcomp}")
    [ -n "${pr_min_intface_hbonds}" ] && pdj_args+=(--pr_min_intface_hbonds "${pr_min_intface_hbonds}")
    [ -n "${pr_max_intface_unsat_hbonds}" ] && pdj_args+=(--pr_max_intface_unsat_hbonds "${pr_max_intface_unsat_hbonds}")
    [ -n "${pr_max_surfhphobics}" ] && pdj_args+=(--pr_max_surfhphobics "${pr_max_surfhphobics}")

    printf -v workflow_args '%q ' "${pdj_args[@]}" \
        -c "${PDJ_NEXTFLOW_CONFIG}" \
        -profile apptainer \
        "${PDJ_VERSION_ARGS[@]}"
    write_metrics "${PDJ_REPOSITORY}" "${PDJ_REVISION}" "${PDJ_NEXTFLOW_CONFIG}" "${workflow_args}"

    nextflow run "${PDJ_REPOSITORY}" \
        "${pdj_args[@]}" \
        -c "${PDJ_NEXTFLOW_CONFIG}" \
        -profile apptainer \
        "${PDJ_VERSION_ARGS[@]}"
