<%
portal_default_cluster = "katana"
portal_default_molstar_url_template = "/pun/sys/dashboard/files/fs/__PATH_SEGMENTS__"
%>

form:
    - data_warning
    - run_name
    - target
    - target_preview
    - target_crop
    - target_crop_validation
    - target_size_warning
    - hotspots
    - hotspot_validation
    - pdj_design_mode
    - pdj_show_backbone_advanced
    - flexible_residues
    - rfd_ckpt_override
    - rfd_noise_scale
    - bc_chains
    - bc_design_protocol
    - bc_template_protocol
    - bc_omit_aas
    - bc_fix_interface_residues
    - minlen
    - maxlen
    - ndesigns
    - seqs_per_design
    - pdj_seq_method
    - pdj_show_sequence_advanced
    - mpnn_checkpoint_type
    - mpnn_checkpoint_model
    - mpnn_backbone_noise
    - mpnn_relax_max_cycles
    - pdj_pred_method
    - pdj_show_folding_advanced
    - uncropped_target_pdb
    - af2_initial_guess
    - boltz_use_templates
    - boltz_input_msa
    - boltz_recycling_steps
    - boltz_diffusion_samples
    - boltz_sampling_steps
    - boltz_use_potentials
    - boltz_predict_unbound_binder
    - pdj_show_filtering_advanced
    - zip_pdbs
    - rank_designs
    - ranking_metric
    - fold_min_ss
    - seq_min_ext_coef
    - max_designs
    - max_seqs_per_fold
    - af2_max_pae_interaction
    - af2_min_iptm
    - af2_min_plddt_overall
    - af2_max_rmsd_binder_bndaln
    - af2_max_rmsd_binder_tgtaln
    - boltz_max_rmsd_binder
    - boltz_max_rmsd_target
    - boltz_max_rmsd_overall
    - boltz_min_iptm
    - boltz_min_ipsae_min
    - boltz_min_pdockq2_min
    - pr_min_intface_shpcomp
    - pr_min_intface_hbonds
    - pr_max_intface_unsat_hbonds
    - pr_max_surfhphobics
    - citation_request
    - katana_citation

cluster: "<%= portal_default_cluster %>"

attributes:
    data_warning:
        class: "d-none"
        help: |
            <div style="padding: 0.375rem 0.75rem; background-color: #E2BEBE; border: 2px solid #761313; border-radius: 0.25rem; color: #761313;">
                <span><b>Warning!</b> Please ensure your input data complies with your site's data handling rules. Many HPC clusters are <b>not</b> approved for sensitive or highly sensitive data.</span>
            </div>

    run_name:
        widget: "text_field"
        pattern: '^[A-Za-z0-9_\- ]+$'
        label: "Run Name"
        placeholder: "Job_name"
        required: true
        help: |
            Alphanumeric, space, "_" and "-" only.

    target:
        widget: "path_selector"
        label: "Target PDB"
        pattern: ".*\\.pdb$"
        placeholder: "/path/to/my_project/target.pdb"
        required: true
        help: |
            Path to a PDB file containing the target structure. The input
            structure must contain at least 50 standard amino-acid residues.

    target_preview:
        class: "d-none"
        help: |
            <div id="ood-molstar-preview"
                 data-url-template="<%= portal_default_molstar_url_template %>">
                <button type="button" id="ood-molstar-load" class="btn btn-secondary btn-sm">
                    Preview Target
                </button>
                <div class="btn-group btn-group-sm" role="group" aria-label="Mol* selection mode" style="margin-left: 0.5rem;">
                    <button type="button" id="ood-molstar-mode-hotspots" class="btn btn-primary">Select hotspots</button>
                    <button type="button" id="ood-molstar-mode-crop" class="btn btn-outline-primary">Crop target</button>
                    <button type="button" id="ood-molstar-apply-crop" class="btn btn-outline-primary" hidden>Apply crop</button>
                    <button type="button" id="ood-molstar-clear-crop" class="btn btn-outline-secondary" hidden>Clear crop</button>
                </div>
                <div style="margin-top: 0.5rem; color: #555;">
                    In hotspot mode, click residues to add or remove hotspots. In crop mode,
                    select the residues to retain, then apply the crop. Shift-click can extend a selection.
                </div>
                <div id="ood-molstar-crop-summary" style="margin-top: 0.5rem; color: #555;"></div>
                <div id="ood-molstar-status" style="margin-top: 0.5rem; color: #555;"></div>
                <div id="ood-molstar-container" style="height: 420px; margin-top: 0.75rem; border: 1px solid #d0d0d0; border-radius: 0.25rem; overflow: hidden;"></div>
            </div>

    target_size_warning:
        class: "d-none"
        label: ""
        help: |
            <div id="ood-target-size-warning" hidden
                 style="padding: 0.375rem 0.75rem; background-color: #FFF3CD; border: 2px solid #856404; border-radius: 0.25rem; color: #664D03;">
            </div>

    target_crop:
        widget: "text_field"
        label: "Target Crop (optional)"
        placeholder: "A120-310"
        pattern: '^[A-Za-z0-9,\- ]*$'
        help: |
            In <i>Crop target</i> mode, select the residues to retain and click
            <i>Apply crop</i>. Use chain-qualified ranges such as A120-310.
            The original PDB is unchanged; a derived PDB is created in the job directory.

    target_crop_validation:
        class: "d-none"
        label: ""
        help: |
            <div id="ood-target-crop-validation" hidden
                 style="margin-top: 0.25rem; color: #9f1d1d;"></div>

    hotspots:
        widget: "text_field"
        label: "Target Hotspots"
        placeholder: "231,235 or A231,A235-240"
        pattern: '^[A-Za-z0-9,\- ]*$'
        help: |
            Optional. Use residue numbers (for a single-chain target), or
            ProteinDJ residue specifications such as A231, A235-240, or A.
            Up to 8 hotspot residues may be selected (ranges count each
            residue).

    hotspot_validation:
        class: "d-none"
        label: ""
        help: |
            <div id="ood-hotspot-validation" hidden
                 style="margin-top: 0.25rem; color: #9f1d1d;"></div>

    pdj_design_mode:
        widget: "select"
        label: "Backbone Design Method"
        options:
            - ["RFdiffusion", "rfd_denovo", data-hide-bc_chains: true, data-hide-bc_design_protocol: true, data-hide-bc_template_protocol: true, data-hide-bc_omit_aas: true, data-hide-bc_fix_interface_residues: true]
            - ["FreeBindCraft", "bindcraft_denovo", data-hide-flexible_residues: true, data-hide-rfd_ckpt_override: true, data-hide-rfd_noise_scale: true]
        help: |
            FreeBindCraft is ProteinDJ's PyRosetta-free BindCraft implementation.

    minlen:
        widget: "number_field"
        label: "Minimum Length"
        value: 60
        min: 10
        max: 199
        required: true

    maxlen:
        widget: "number_field"
        label: "Maximum Length"
        value: 100
        min: 11
        max: 200
        required: true

    ndesigns:
        widget: "number_field"
        label: "Number of Designs"
        value: 100
        min: 1
        max: 1000
        required: true

    seqs_per_design:
        widget: "number_field"
        label: "Sequences per Backbone Design"
        value: 8
        min: 1
        max: 20

    pdj_seq_method:
        widget: "select"
        label: "Sequence Design Method"
        help: |
            ProteinMPNN is generally preferred for binder quality.
        options:
            - ["Soluble ProteinMPNN (+OpenMMRelax)", "mpnn"]
            - ["FAMPNN", "fampnn", data-hide-mpnn_checkpoint_type: true, data-hide-mpnn_checkpoint_model: true, data-hide-mpnn_backbone_noise: true, data-hide-mpnn_relax_max_cycles: true]

    pdj_pred_method:
        widget: "select"
        label: "Structure Prediction Method"
        options:
            - ["Boltz-2", "boltz", data-hide-af2_max_pae_interaction: true, data-hide-af2_min_iptm: true, data-hide-af2_min_plddt_overall: true, data-hide-af2_max_rmsd_binder_bndaln: true, data-hide-af2_max_rmsd_binder_tgtaln: true, data-hide-af2_initial_guess: true]
            - ["AlphaFold2 Initial Guess", "af2", data-hide-boltz_use_templates: true, data-hide-boltz_input_msa: true, data-hide-boltz_recycling_steps: true, data-hide-boltz_diffusion_samples: true, data-hide-boltz_sampling_steps: true, data-hide-boltz_use_potentials: true, data-hide-boltz_predict_unbound_binder: true, data-hide-boltz_max_rmsd_binder: true, data-hide-boltz_max_rmsd_target: true, data-hide-boltz_max_rmsd_overall: true, data-hide-boltz_min_iptm: true, data-hide-boltz_min_ipsae_min: true, data-hide-boltz_min_pdockq2_min: true]
            - ["AlphaFold2 then Boltz-2", "af2_boltz"]

    pdj_show_backbone_advanced:
        widget: "check_box"
        label: "Show Advanced Backbone Design Options"
        checked_value: "yes"
        unchecked_value: "no"

    pdj_show_sequence_advanced:
        widget: "check_box"
        label: "Show Advanced Sequence Design Options"
        checked_value: "yes"
        unchecked_value: "no"

    pdj_show_folding_advanced:
        widget: "check_box"
        label: "Show Advanced Structure Prediction Options"
        checked_value: "yes"
        unchecked_value: "no"

    pdj_show_filtering_advanced:
        widget: "check_box"
        label: "Show Advanced Filtering and Ranking Options"
        checked_value: "yes"
        unchecked_value: "no"

    flexible_residues:
        widget: "text_field"
        label: "Flexible Target Residues (RFdiffusion)"
        placeholder: "A10-35"
        pattern: '^[A-Za-z0-9,\- ]*$'
        help: |
            Optional target residues whose structure should not constrain RFdiffusion.

    rfd_ckpt_override:
        widget: "select"
        label: "RFdiffusion Checkpoint"
        options:
            - ["Automatic", ""]
            - ["Complex beta-sheet", "complex_beta"]
            - ["Complex base", "complex_base"]

    rfd_noise_scale:
        widget: "number_field"
        label: "RFdiffusion Noise Scale"
        min: 0
        max: 1
        step: 0.1
        help: |
            Optional. Lower values generally trade diversity for binder success rate.

    bc_chains:
        widget: "text_field"
        label: "FreeBindCraft Target Chains"
        placeholder: "A or A,B"
        pattern: '^[A-Za-z]+(,[A-Za-z]+)*$'
        help: |
            Optional. Leave blank to target all protein chains in the structure.

    bc_design_protocol:
        widget: "select"
        label: "FreeBindCraft Design Protocol"
        options:
            - ["Default", "default"]
            - ["Beta-sheet", "betasheet"]
            - ["Helical peptide", "peptide"]

    bc_template_protocol:
        widget: "select"
        label: "FreeBindCraft Target Flexibility"
        options:
            - ["Default", "default"]
            - ["Flexible", "flexible"]

    bc_omit_aas:
        widget: "text_field"
        label: "FreeBindCraft Amino Acids to Avoid"
        value: "C"
        pattern: '^[A-Za-z, ]*$'
        help: |
            Comma-separated one-letter amino-acid codes.

    bc_fix_interface_residues:
        widget: "check_box"
        label: "Preserve FreeBindCraft Interface Residues"
        checked_value: "true"
        unchecked_value: "false"
        checked: true

    mpnn_checkpoint_type:
        widget: "select"
        label: "ProteinMPNN Checkpoint"
        options:
            - ["Soluble (recommended)", "soluble"]
            - ["Vanilla", "vanilla"]
            - ["HyperMPNN", "hyper"]

    mpnn_checkpoint_model:
        widget: "select"
        label: "ProteinMPNN Checkpoint Model"
        options:
            - ["v_48_020 (recommended)", "v_48_020"]
            - ["v_48_002", "v_48_002"]
            - ["v_48_010", "v_48_010"]
            - ["v_48_030", "v_48_030"]

    mpnn_backbone_noise:
        widget: "number_field"
        label: "ProteinMPNN Backbone Noise"
        value: 0
        min: 0
        max: 1
        step: 0.01

    mpnn_relax_max_cycles:
        widget: "number_field"
        label: "OpenMM Relaxation Cycles"
        value: 1
        min: 0
        max: 10
        help: |
            Set to 0 to disable ProteinMPNN-OpenMMRelax.

    uncropped_target_pdb:
        widget: "path_selector"
        label: "Uncropped target PDB (optional)"
        pattern: ".*\\.pdb$"
        placeholder: "/path/to/my_project/target_uncropped.pdb"

    af2_initial_guess:
        widget: "select"
        label: "Use AlphaFold2 Target Initial Guess"
        options:
            - ["Yes", "true"]
            - ["No", "false"]

    boltz_use_templates:
        widget: "select"
        label: "Boltz Use Templates"
        options:
            - ["Yes", "true"]
            - ["No", "false"]

    boltz_input_msa:
        widget: "path_selector"
        label: "Boltz Input MSA (optional)"
        pattern: ".*\\.a3m$"
        placeholder: "/path/to/my_project/target.a3m"

    boltz_recycling_steps:
        widget: "number_field"
        label: "Boltz Recycling Steps"
        value: 3
        min: 0
        max: 20

    boltz_diffusion_samples:
        widget: "number_field"
        label: "Boltz Diffusion Samples"
        value: 1
        min: 1
        max: 10

    boltz_sampling_steps:
        widget: "number_field"
        label: "Boltz Sampling Steps"
        value: 200
        min: 1
        max: 500

    boltz_use_potentials:
        widget: "check_box"
        label: "Use Boltz-2 Physics Potentials"
        checked_value: "true"
        unchecked_value: "false"

    boltz_predict_unbound_binder:
        widget: "check_box"
        label: "Predict Unbound Binder with Boltz-2"
        checked_value: "true"
        unchecked_value: "false"

    zip_pdbs:
        widget: "check_box"
        label: "Compress Final PDB Files"
        checked_value: "true"
        unchecked_value: "false"
        checked: true

    rank_designs:
        widget: "check_box"
        label: "Rank Final Designs"
        checked_value: "true"
        unchecked_value: "false"
        checked: true

    ranking_metric:
        widget: "select"
        label: "Ranking Metric"
        options:
            - ["Automatic for prediction method", ""]
            - ["AF2 interface PAE", "af2_pae_interaction"]
            - ["Boltz ipSAE minimum", "boltz_ipSAE_min"]
            - ["Boltz interface pTM", "boltz_iptm"]

    fold_min_ss:
        widget: "number_field"
        label: "Min Secondary Structure Elements"
        min: 0
        max: 10
        value: 3

    seq_min_ext_coef:
        widget: "number_field"
        label: "Min Extinction Coefficient"
        value: 1000
        min: 0

    max_designs:
        widget: "number_field"
        label: "Max Final Designs to Keep"
        min: 1
        value: 100
        max: 1000

    max_seqs_per_fold:
        widget: "number_field"
        label: "Max Sequences per Fold"
        min: 1
        max: 10
        value: 4

    af2_max_pae_interaction:
        widget: "number_field"
        label: "AF2 max PAE interaction"
        value: 10
        min: 0

    af2_min_iptm:
        widget: "number_field"
        label: "AF2 minimum interface pTM"
        min: 0
        max: 1
        step: 0.01

    af2_min_plddt_overall:
        widget: "number_field"
        label: "AF2 min pLDDT overall"
        value: 90
        min: 0
        max: 100

    af2_max_rmsd_binder_bndaln:
        widget: "number_field"
        label: "AF2 max binder RMSD (binder-aligned)"
        value: 1.5
        min: 0
        step: 0.1

    af2_max_rmsd_binder_tgtaln:
        widget: "number_field"
        label: "AF2 max binder RMSD (target-aligned)"
        value: 2
        min: 0
        step: 0.1

    boltz_max_rmsd_binder:
        widget: "number_field"
        label: "Boltz max binder RMSD"
        value: 1.5
        min: 0
        step: 0.1

    boltz_max_rmsd_target:
        widget: "number_field"
        label: "Boltz max target RMSD"
        value: 2
        min: 0
        step: 0.1

    boltz_max_rmsd_overall:
        widget: "number_field"
        label: "Boltz max overall RMSD"
        value: 2.5
        min: 0
        step: 0.1

    boltz_min_iptm:
        widget: "number_field"
        label: "Boltz min interface pTM"
        value: 0.85
        min: 0
        max: 1
        step: 0.01

    boltz_min_ipsae_min:
        widget: "number_field"
        label: "Boltz minimum interface ipSAE"
        min: 0
        max: 1
        step: 0.01

    boltz_min_pdockq2_min:
        widget: "number_field"
        label: "Boltz minimum interface pDockQ2"
        min: 0
        max: 1
        step: 0.01

    pr_min_intface_shpcomp:
        widget: "number_field"
        label: "Minimum interface shape complementarity"
        min: 0
        max: 1
        step: 0.01

    pr_min_intface_hbonds:
        widget: "number_field"
        label: "Minimum interface hydrogen bonds"
        min: 0

    pr_max_intface_unsat_hbonds:
        widget: "number_field"
        label: "Maximum unsatisfied interface hydrogen bonds"
        min: 0

    pr_max_surfhphobics:
        widget: "number_field"
        label: "Maximum surface hydrophobics (%)"
        min: 0
        max: 100

    citation_request:
        label: "Facility Citation"
        class: "d-none"
        help: |
            Please include the following acknowledgement in publications that use this resource:
            <br>
            <i>"The authors acknowledge use of facilities in the Structural Biology Facility within the Mark Wainwright Analytical Centre - UNSW"</i>
            <br>
            <b>DOI:</b> <a href="https://doi.org/10.26190/4KQF-M552">10.26190/4KQF-M552</a>

    katana_citation:
        label: "Katana HPC Citation"
        class: "d-none"
        help: |
            Please include the following acknowledgement in publications that use Katana:
            <br>
            <i>"This research includes computations using the computational cluster Katana supported by Research Technology Services at UNSW Sydney."</i>
            <br>
            <b>DOI:</b> <a href="https://doi.org/10.26190/669x-a286">10.26190/669X-A286</a>
