#!/bin/bash

set -xo pipefail
set -eE

WORKFLOW="<%= context.workflow %>"
RUN_DIR=$(echo "<%= context.run_name %>" | sed "s#[^A-Za-z0-9]#_#g")

ENV_FILE=".env"
if [ -f "$ENV_FILE" ]; then
    set -a
    . "$ENV_FILE"
    set +a
fi

DEBUGGROUP=${DEBUGGROUP:-sbf}
BASE_DEBUGDIR=${BASE_DEBUGDIR:-/srv/scratch/sbf/debug}
METRICS_DIRECTORY=${METRICS_DIRECTORY:-/srv/scratch/sbf-pipelines/metrics}
ENABLE_METRICS=${ENABLE_METRICS:-true}
NOW=$(date +%Y%m%d_%H%M%S)
RUNNAME="${NOW}_${USER}"
DEBUGDIR="${BASE_DEBUGDIR}/proteindesign_${WORKFLOW}_${RUNNAME}"

collect_debug_files() {
    local exit_code=$?

    trap - ERR
    set +e
    echo "Error occurred, copying debug files to ${DEBUGDIR}"
    mkdir -p "${DEBUGDIR}"
    {
        echo "captured_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "user=${USER}"
        echo "node=$(hostname)"
        echo "pbs_jobid=${PBS_JOBID:-}"
        echo "workflow=${WORKFLOW}"
        echo "run_name=<%= context.run_name %>"
        echo "session_output_dir=$(pwd -P)"
        echo "nxf_work=${NXF_WORK:-}"
        echo "exit_code=${exit_code}"
    } > "${DEBUGDIR}/debug-metadata.txt"
    rsync -a --no-perms --no-owner --no-group --max-size=50m . "${DEBUGDIR}/"
    if [ -n "${NXF_WORK:-}" ] && [ -d "${NXF_WORK}" ]; then
        rsync -a --no-perms --no-owner --no-group --max-size=50m "${NXF_WORK}" "${DEBUGDIR}/"
    fi
    find "${DEBUGDIR}" -type d -exec chmod 2770 {} +
    find "${DEBUGDIR}" -type f -exec chmod 660 {} +
    chgrp "${DEBUGGROUP}" -R "${DEBUGDIR}"
    exit "${exit_code}"
}

write_metrics() {
    local repository="$1"
    local revision="$2"
    local nf_config="$3"
    local workflow_args="$4"
    local metrics_log_path

    [[ "${ENABLE_METRICS}" == "true" ]] || return 0
    metrics_log_path="${METRICS_DIRECTORY}/$(date +%Y/%m)"
    if ! mkdir -p "${metrics_log_path}" || ! jq -n \
        --arg date "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg user "$(whoami)" \
        --arg node "$(hostname)" \
        --arg pbs_jobid "${PBS_JOBID:-}" \
        --arg app "ood-proteindesign" \
        --arg workflow "${WORKFLOW}" \
        --arg run_name "<%= context.run_name %>" \
        --arg repository "${repository}" \
        --arg revision "${revision}" \
        --arg nf_config "${nf_config}" \
        --arg target "${target}" \
        --arg target_chain "${chain}" \
        --arg hotspots "${hotspots}" \
        --arg min_length "${min_length}" \
        --arg max_length "${max_length}" \
        --arg number_of_designs "${ndesigns}" \
        --arg outdir "${OUT_DIR}" \
        --arg nxf_work "${NXF_WORK}" \
        --arg profile "apptainer" \
        --arg args "${workflow_args}" \
        '{date: $date, user: $user, node: $node, pbs_jobid: $pbs_jobid, app: $app, workflow: $workflow, run_name: $run_name, repository: $repository, revision: $revision, nf_config: $nf_config, target: $target, target_chain: $target_chain, hotspots: $hotspots, min_length: $min_length, max_length: $max_length, number_of_designs: $number_of_designs, outdir: $outdir, nxf_work: $nxf_work, profile: $profile, args: $args}' \
        > "${metrics_log_path}/$(date -u +%Y-%m-%dT%H:%M:%SZ)-$(whoami)-${PBS_JOBID:-unknown}.json"; then
        echo "Warning: unable to write metrics log to ${metrics_log_path}; continuing without metrics." >&2
    fi
}

trap 'collect_debug_files' ERR

require_var() {
    local name="$1"
    if [ -z "${!name:-}" ]; then
        echo "ERROR: Required config variable '$name' is not set. Define it in template/.env or the environment." >&2
        exit 1
    fi
}

require_var APPTAINER_CACHEDIR
require_var NXF_APPTAINER_CACHEDIR
require_var NXF_APPTAINER_LIBRARYDIR

module purge
module load java/21 nextflow/24

export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR}"
export NXF_APPTAINER_CACHEDIR="${NXF_APPTAINER_CACHEDIR}"
export NXF_APPTAINER_LIBRARYDIR="${NXF_APPTAINER_LIBRARYDIR}"

if [ "$WORKFLOW" = "bindflow" ]; then
    require_var PROTEINDESIGN_BIND_BASEDIR
    require_var PROTEINDESIGN_BIND_REPOSITORY
    require_var PROTEINDESIGN_BIND_REVISION
    require_var PROTEINDESIGN_BIND_NEXTFLOW_CONFIG
    require_var PROTEINDESIGN_BIND_WORK_DIR
    require_var PROTEINDESIGN_BIND_OUT_DIR
    BASEDIR="${PROTEINDESIGN_BIND_BASEDIR}"
    JOBCONFIGDIR=${BASEDIR}/advanced/
    FILTERCONFIGDIR=${BASEDIR}/filters/
    BIND_REPOSITORY="${PROTEINDESIGN_BIND_REPOSITORY}"
    BIND_REVISION="${PROTEINDESIGN_BIND_REVISION}"
    BIND_NEXTFLOW_CONFIG="${PROTEINDESIGN_BIND_NEXTFLOW_CONFIG}"

    export NXF_WORK="${PROTEINDESIGN_BIND_WORK_DIR}"
    mkdir -p "${NXF_WORK}"

    BASE_OUT_DIR="${BASE_OUT_DIR:-${PROTEINDESIGN_BIND_OUT_DIR}}"
    OUT_DIR="${BASE_OUT_DIR}/${RUN_DIR}"
    mkdir -p "${OUT_DIR}"
    LIVE_LOG="live_log.log"
    if [ -z "${OOD_LIVE_LOG_INIT:-}" ]; then
        export OOD_LIVE_LOG_INIT=1
        : > "${LIVE_LOG}"
        exec > >(tee -a "${LIVE_LOG}")
        exec 2>&1
    fi

    run_name="<%= context.run_name %>"
    target="<%= context.target %>"
    chain="<%= context.target_chain %>"
    hotspots="<%= context.hotspots %>"
    min_length="<%= context.minlen %>"
    max_length="<%= context.maxlen %>"
    ndesigns="<%= context.ndesigns %>"
    jobconfig="<%= context.jobconfig %>"
    filterconfig="<%= context.filterconfig %>"

    echo "id,binder_name,starting_pdb,chains,target_hotspot_residues,min_length,max_length,number_of_final_designs,settings_advanced,settings_filters" > samplesheet.csv
    printf '"%s","%s","%s","%s","%s",%s,%s,%s,"%s","%s"\n' \
        "${run_name}" \
        "${run_name}" \
        "${target}" \
        "${chain}" \
        "${hotspots}" \
        "${min_length}" \
        "${max_length}" \
        "${ndesigns}" \
        "${JOBCONFIGDIR}/${jobconfig}" \
        "${FILTERCONFIGDIR}/${filterconfig}" >> samplesheet.csv

    printf -v workflow_args '%q ' \
        --input samplesheet.csv \
        --outdir "${OUT_DIR}" \
        -c "${BIND_NEXTFLOW_CONFIG}" \
        -profile apptainer \
        -r "${BIND_REVISION}" \
        -latest
    write_metrics "${BIND_REPOSITORY}" "${BIND_REVISION}" "${BIND_NEXTFLOW_CONFIG}" "${workflow_args}"

    nextflow run "${BIND_REPOSITORY}" \
        --input samplesheet.csv \
        --outdir ${OUT_DIR} \
        -c "${BIND_NEXTFLOW_CONFIG}" \
        -profile apptainer \
        -r "${BIND_REVISION}" \
        -latest
else
    require_var PROTEINDESIGN_PDJ_BASEDIR
    require_var PROTEINDESIGN_PDJ_REPOSITORY
    require_var PROTEINDESIGN_PDJ_REVISION
    require_var PROTEINDESIGN_PDJ_NEXTFLOW_CONFIG
    require_var PROTEINDESIGN_PDJ_WORK_DIR
    require_var PROTEINDESIGN_PDJ_OUT_DIR
    BASE_DIR="${PROTEINDESIGN_PDJ_BASEDIR}"
    MODEL_DIR=${BASE_DIR}/models/
    PDJ_REPOSITORY="${PROTEINDESIGN_PDJ_REPOSITORY}"
    PDJ_REVISION="${PROTEINDESIGN_PDJ_REVISION}"
    PDJ_NEXTFLOW_CONFIG="${PROTEINDESIGN_PDJ_NEXTFLOW_CONFIG}"

    export NXF_WORK="${PROTEINDESIGN_PDJ_WORK_DIR}"
    mkdir -p "${NXF_WORK}"

    BASE_OUT_DIR="${BASE_OUT_DIR:-${PROTEINDESIGN_PDJ_OUT_DIR}}"
    OUT_DIR="${BASE_OUT_DIR}/${RUN_DIR}"
    mkdir -p "${OUT_DIR}"
    LIVE_LOG="live_log.log"
    if [ -z "${OOD_LIVE_LOG_INIT:-}" ]; then
        export OOD_LIVE_LOG_INIT=1
        : > "${LIVE_LOG}"
        exec > >(tee -a "${LIVE_LOG}")
        exec 2>&1
    fi

    run_name="<%= context.run_name %>"
    target="<%= context.target %>"
    chain="<%= context.target_chain %>"
    seq_method="<%= context.pdj_seq_method %>"
    pred_method="<%= context.pdj_pred_method %>"
    hotspots_raw="<%= context.hotspots %>"
    hotspots_clean=$(echo "${hotspots_raw}" | tr -d '[:space:]' | sed -E 's/,+/,/g; s/^,//; s/,$//')

    # ProteinDJ expects chain-prefixed hotspots (e.g. A231). We accept numeric
    # input and defensively avoid double-prefixing if a chain was provided.
    hotspots=""
    IFS=',' read -r -a hotspot_items <<< "${hotspots_clean}"
    for item in "${hotspot_items[@]}"; do
        [ -z "${item}" ] && continue

        if [[ "${item}" =~ ^[0-9]+$ ]]; then
            formatted="${chain}${item}"
        elif [[ "${item}" =~ ^[A-Za-z][0-9]+$ ]]; then
            formatted="${item}"
        else
            formatted="${item}"
        fi

        if [ -n "${hotspots}" ]; then
            hotspots="${hotspots},${formatted}"
        else
            hotspots="${formatted}"
        fi
    done
    min_length="<%= context.minlen %>"
    max_length="<%= context.maxlen %>"
    ndesigns="<%= context.ndesigns %>"
    nseqs="<%= context.seqs_per_design %>"
    design_length="${min_length}-${max_length}"

    af2_max_pae_interaction="<%= context.af2_max_pae_interaction %>"
    af2_min_plddt_overall="<%= context.af2_min_plddt_overall %>"
    af2_max_rmsd_binder_bndaln="<%= context.af2_max_rmsd_binder_bndaln %>"
    af2_max_rmsd_binder_tgtaln="<%= context.af2_max_rmsd_binder_tgtaln %>"

    boltz_max_rmsd_binder="<%= context.boltz_max_rmsd_binder %>"
    boltz_max_rmsd_target="<%= context.boltz_max_rmsd_target %>"
    boltz_max_rmsd_overall="<%= context.boltz_max_rmsd_overall %>"
    boltz_min_ptm_interface="<%= context.boltz_min_ptm_interface %>"

    mpnn_relax_max_cycles="<%= context.mpnn_relax_max_cycles %>"
    uncropped_target_pdb="<%= context.uncropped_target_pdb %>"
    boltz_use_templates="<%= context.boltz_use_templates %>"
    boltz_input_msa="<%= context.boltz_input_msa %>"
    fold_min_ss="<%= context.fold_min_ss %>"
    seq_min_ext_coef="<%= context.seq_min_ext_coef %>"
    max_designs="<%= context.max_designs %>"
    max_seqs_per_fold="<%= context.max_seqs_per_fold %>"

    pdj_args=(
        # Schema-style names (PapenfussLab/proteindj)
        --design_mode 'binder_denovo'
        --num_designs "${ndesigns}"
        --input_pdb "${target}"
        --hotspot_residues "${hotspots}"
        # Legacy names (older tlitfin/PapenfussLab revisions)
        --rfd_num_designs "${ndesigns}"
        --rfd_mode 'binder_denovo'
        --rfd_input_pdb "${target}"
        --rfd_hotspots "[${hotspots}]"
        --design_length "${design_length}"
        --seqs_per_design "${nseqs}"
        --seq_method "${seq_method}"
        --pred_method "${pred_method}"
        --gpus 20
        --out_dir "${OUT_DIR}"
        --af2_models "${MODEL_DIR}/af2/"
        --rfd_models "${MODEL_DIR}/rfd/"
        --boltz_models "${MODEL_DIR}/boltz/"
    )

    if [ "${pred_method}" = "af2" ]; then
        [ -n "${af2_max_pae_interaction}" ] && pdj_args+=(--af2_max_pae_interaction "${af2_max_pae_interaction}")
        [ -n "${af2_min_plddt_overall}" ] && pdj_args+=(--af2_min_plddt_overall "${af2_min_plddt_overall}")
        [ -n "${af2_max_rmsd_binder_bndaln}" ] && pdj_args+=(--af2_max_rmsd_binder_bndaln "${af2_max_rmsd_binder_bndaln}")
        [ -n "${af2_max_rmsd_binder_tgtaln}" ] && pdj_args+=(--af2_max_rmsd_binder_tgtaln "${af2_max_rmsd_binder_tgtaln}")
    elif [ "${pred_method}" = "boltz" ]; then
        [ -n "${boltz_use_templates}" ] && pdj_args+=(--boltz_use_templates "${boltz_use_templates}")
        [ -n "${boltz_input_msa}" ] && pdj_args+=(--boltz_input_msa "${boltz_input_msa}")
        [ -n "${boltz_max_rmsd_binder}" ] && pdj_args+=(--boltz_max_rmsd_binder "${boltz_max_rmsd_binder}")
        [ -n "${boltz_max_rmsd_target}" ] && pdj_args+=(--boltz_max_rmsd_target "${boltz_max_rmsd_target}")
        [ -n "${boltz_max_rmsd_overall}" ] && pdj_args+=(--boltz_max_rmsd_overall "${boltz_max_rmsd_overall}")
        [ -n "${boltz_min_ptm_interface}" ] && pdj_args+=(--boltz_min_ptm_interface "${boltz_min_ptm_interface}")
    fi

    [ -n "${mpnn_relax_max_cycles}" ] && pdj_args+=(--mpnn_relax_max_cycles "${mpnn_relax_max_cycles}")
    [ -n "${uncropped_target_pdb}" ] && pdj_args+=(--uncropped_target_pdb "${uncropped_target_pdb}")
    [ -n "${fold_min_ss}" ] && pdj_args+=(--fold_min_ss "${fold_min_ss}")
    [ -n "${seq_min_ext_coef}" ] && pdj_args+=(--seq_min_ext_coef "${seq_min_ext_coef}")
    [ -n "${max_designs}" ] && pdj_args+=(--max_designs "${max_designs}")
    [ -n "${max_seqs_per_fold}" ] && pdj_args+=(--max_seqs_per_fold "${max_seqs_per_fold}")

    printf -v workflow_args '%q ' "${pdj_args[@]}" \
        -c "${PDJ_NEXTFLOW_CONFIG}" \
        -profile apptainer \
        -r "${PDJ_REVISION}" \
        -latest
    write_metrics "${PDJ_REPOSITORY}" "${PDJ_REVISION}" "${PDJ_NEXTFLOW_CONFIG}" "${workflow_args}"

    nextflow run "${PDJ_REPOSITORY}" \
        "${pdj_args[@]}" \
        -c "${PDJ_NEXTFLOW_CONFIG}" \
        -profile apptainer \
        -r "${PDJ_REVISION}" \
        -latest
fi
